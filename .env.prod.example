POSTGRES_DB=drought
POSTGRES_USER=drought_user
POSTGRES_PASSWORD=change-this-long-random-password

# Keep this password URL-safe, or URL-encode special characters.
DATABASE_URL=postgresql+psycopg2://drought_user:change-this-long-random-password@db:5432/drought

APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://drought.werifum.ir

MAP_LIMIT_DEFAULT=2000
MAP_LIMIT_MAX=10000
CACHE_TTL_SHORT_SECONDS=300
CACHE_TTL_MEDIUM_SECONDS=900
CACHE_TTL_LONG_SECONDS=1800
CACHE_TTL_DAILY_SECONDS=86400
